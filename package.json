{
  "name": "edu-joel",
  "productName": "Aprende con Joel",
  "version": "1.1.0",
  "description": "App educativa con modo Papá (crear cursos) y modo Alumno (hacer sesiones)",
  "main": "main.js",
  "author": "Papá de Joel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.familia.edujoel",
    "productName": "Aprende con Joel",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aprende con Joel"
    },
    "portable": { "artifactName": "AprendeConJoel-portable-${version}.exe" }
  }
}
